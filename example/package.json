{
  "name": "mrz-scanner-example",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_UNSTABLE_BONJOUR=0 expo start",
    "android": "EXPO_UNSTABLE_BONJOUR=0 expo run:android",
    "ios": "EXPO_UNSTABLE_BONJOUR=0 expo run:ios",
