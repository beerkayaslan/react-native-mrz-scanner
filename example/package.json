    "postinstall": "npx --yes patch-package"
  },
  "dependencies": {
    "expo": "~55.0.2",
    "expo-camera": "^55.0.9",
    "expo-constants": "^55.0.7",
    "expo-linking": "^55.0.7",
    "expo-router": "^55.0.2",
    "expo-status-bar": "~55.0.4",
    "mrz": "^5.0.1",
    "rn-mrz-scanner": "file:..",
    "passport-reader": "file:./passport-reader",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.2",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
